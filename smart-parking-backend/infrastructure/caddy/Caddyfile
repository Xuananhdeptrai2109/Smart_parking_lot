{$PUBLIC_HOST:localhost} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle /socket.io/* {
        reverse_proxy backend:3000
    }

    handle /uploads/* {
        reverse_proxy backend:3000
    }

    handle /health {
        reverse_proxy backend:3000
    }

    handle {
        reverse_proxy frontend:80
    }
}
