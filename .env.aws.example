# Copy to smart-parking-backend/.env.production on the deployment machine.
# Never commit the real values.
DATABASE_URL="mysql://USER:PASSWORD@RDS_PRIVATE_ENDPOINT:3306/smart_parking"
PORT=3000
CORS_ORIGIN=https://vuaiot.io.vn

MQTT_CLIENT_ID=smart-parking-backend-aws
MQTT_USERNAME=smart_parking_device
MQTT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MQTT_TOPIC_PREFIX=smart-parking

PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=20000

FRONTEND_HOST=vuaiot.io.vn
PUBLIC_HOST=api.vuaiot.io.vn
PUBLIC_BASE_URL=https://api.vuaiot.io.vn
FRONTEND_URL=https://vuaiot.io.vn
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL

CAMERA_DEVICE_CODE=CAMERA_MAIN
ANPR_DEVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_DEVICE_KEY
PLATE_RECOGNIZER_TOKEN=
ANPR_REGION=vn
ANPR_MIN_SCORE=0.55
ANPR_TIMEOUT_MS=30000

FIRE_FLAME_THRESHOLD=0.65
FIRE_GAS_THRESHOLD=0.90
FIRE_PUMP_MAX_RUN_SECONDS=30
FIRE_BUZZER_DEVICE_CODE=FIRE_BUZZER
FIRE_SERVO_DEVICE_CODE=FIRE_SERVO_CONTROLLER
FIRE_PUMP_DEVICE_CODE=FIRE_PUMP_RELAY

PARKING_PRICE_FIRST_2_HOURS=10000
PARKING_PRICE_UP_TO_5_HOURS=20000
PARKING_PRICE_EXTRA_HOUR=5000
PARKING_QR_EXPIRES_MINUTES=5

# Optional. Anything beginning with VITE_ becomes visible in browser JavaScript.
VITE_CAMERA_PREVIEW_TOKEN=
